{
  "name": "monitor-red",
  "version": "2.1.0",
  "private": true,
  "description": "Monitor local de dispositivos de red RVF Rio Grande",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "build:win": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.pitu.monitorred",
    "productName": "Monitor Red",
    "files": ["main.js", "preload.js", "server.js", "index.html", "styles.css", "app.js", "data.js", "data.json", "package.json"],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "artifactName": "Monitor-Red-${version}-Setup.exe",
      "oneClick": true,
      "perMachine": false
    },
    "portable": {
      "artifactName": "Monitor-Red-${version}-Portable.exe"
    },
    "publish": null
  }
}
